<UserControl x:Class="RecBinderProject.MacroControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecBinderProject"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="350" MaxHeight="50" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <UniformGrid Rows="2">
            <Label x:Name="recordNameLabel" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="Это название" Foreground="White"/>
            <Label x:Name="recordDescriptionLabel" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="Это просто описание записи, никакого больше функционала в нём нет. Можете написать тут всё что угодно. По умолчанию хранится дата и время создания." FontSize="9" Foreground="White"/>
        </UniformGrid>

        <Button x:Name="playRecordButton" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="{x:Null}" Background="{x:Null}">
            <StackPanel>
                <ui:SymbolIcon Symbol="Play"/>
            </StackPanel>
        </Button>
        
        <Button x:Name="stopRecordButton" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}">
            <StackPanel>
                <ui:SymbolIcon Symbol="Stop"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
