<Window x:Class="RecBinderProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:RecBinderProject"
        
        xmlns:views="clr-namespace:RecBinderProject.Presentation.Views"
        xmlns:appvm="clr-namespace:RecBinderProject.Presentation.ViewModels.AppSettings"
        xmlns:exevm="clr-namespace:RecBinderProject.Presentation.ViewModels.MacroExecution"
       
        xmlns:viewmodels="clr-namespace:RecBinderProject.Presentation.ViewModels.MainWindow" 
        
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        
        mc:Ignorable="d"
        Title="RecBinder" Height="600" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type exevm:MacroRecordingViewModel}">
            <views:MacroRecordingView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type exevm:MacroLibraryViewModel}">
            <views:MacroLibraryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type appvm:AppSettingsViewModel}">
            <views:AppSettingsControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:MacroListItemViewModel}">
            <views:MacroListItemControl />
        </DataTemplate>
    </Window.Resources>

    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200px"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>

        <!-- NAVIGATION BAR -->
        <Border Grid.Column="0" Background="#33080000" BorderThickness="10" CornerRadius="15">
            <ListBox Grid.Row="0"  Background="#00000000" SelectionChanged="ListBox_SelectionChanged">
                <ListBoxItem Content="Список записей" Tag="MacrosList"/>
                <ListBoxItem Content="{Binding LocalizationViewModel.MacroList[RecordingButton], Mode=OneWay}" Tag="Recording"/>

                <ListBoxItem Content="{Binding LocalizationViewModel.MacroList[HelpButton], Mode=OneWay}" Tag="Help"/>
                <ListBoxItem Content="{Binding LocalizationViewModel.MacroList[SettingsButton], Mode=OneWay}" Tag="Settings"/>
            </ListBox>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" BorderThickness="10" CornerRadius="15">
            <ContentControl Grid.Column="1" Grid.Row="0" Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>