<Window x:Class="RecBinderProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecBinderProject"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        
        xmlns:vm="clr-namespace:RecBinderProject.ViewModels.MacroExecutionViewModels"
        xmlns:appvm="clr-namespace:RecBinderProject.ViewModels.AppSettingsViewModels"
        xmlns:views="clr-namespace:RecBinderProject.Views" 
       
        xmlns:viewmodels="clr-namespace:RecBinderProject.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="RecBinder" Height="600" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MacroRecordingViewModel}">
            <views:RecordingControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MacroPlaybackViewModel}">
            <views:PlaybackControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type appvm:AppSettingsViewModel}">
            <views:AppSettingsControl />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />
        <ui:NavigationView x:Name="navigationView" PaneTitle="Список записей" PaneDisplayMode="LeftCompact" MenuItemsSource="{Binding MacroControls}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}">
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Создать новую запись" Icon="Video" Tag="createRecord"/>
                <ui:NavigationViewItem Content="Помощь" Icon="Help" Tag="help"/>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</Window>
