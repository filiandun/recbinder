<Window x:Class="RecBinderProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecBinderProject"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="RecBinder" Height="450" Width="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Список записей" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="White" Panel.ZIndex="10"/>
            <Rectangle Grid.RowSpan="2" Fill="#FF212121" RadiusX="5" RadiusY="5"/>

            <ListBox x:Name="recordedEventListBox" Background="{x:Null}"/>

            <UniformGrid Grid.Row="1" Rows="1">
                <Button x:Name="buttonStartRecord" Content="Start" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="ButtonStartRecord_Click"/>
                <Button x:Name ="buttonStopRecord" Content="Stop" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="ButtonStopRecord_Click"/>
                <Button x:Name ="buttonPlayRecord" Content="Play" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="ButtonPlayRecord_Click"/>
            </UniformGrid>
        </Grid>

        <Grid Grid.Column="1" Margin="0, 10, 10, 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="2" Fill="#FF212121" RadiusX="5" RadiusY="5"/>
        </Grid>
        
    </Grid>
</Window>
