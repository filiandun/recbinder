<Window x:Class="RecBinderProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecBinderProject"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="RecBinder" Height="450" Width="800">

    <Grid>
        <ui:Frame x:Name="frame"/>
        <ui:NavigationView x:Name="navigationView" PaneTitle="Список записей" SelectionChanged="NavigationView_SelectionChanged">
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Создать новую запись" Icon="Camera"  Tag="createRecord"/>
                <ui:NavigationViewItem Content="Помощь" Icon="Help" Tag="help"/>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</Window>
