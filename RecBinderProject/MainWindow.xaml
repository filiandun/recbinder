<Window x:Class="RecBinderProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecBinderProject"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        
        xmlns:views="clr-namespace:RecBinderProject.Views"
        xmlns:appvm="clr-namespace:RecBinderProject.Presentation.ViewModels.AppSettings"
        xmlns:exevm="clr-namespace:RecBinderProject.Presentation.ViewModels.MacroExecution"
       
        xmlns:viewmodels="clr-namespace:RecBinderProject.Presentation.ViewModels.MainWindow" d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="RecBinder" Height="600" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type exevm:MacroRecordingViewModel}">
            <views:RecordingControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type exevm:MacroPlaybackViewModel}">
            <views:PlaybackControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type appvm:AppSettingsViewModel}">
            <views:AppSettingsControl />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:MacroListItemViewModel}">
            <views:MacroListItemControl />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ui:NavigationView x:Name="navigationView" PaneTitle="Список макросов" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" MenuItemsSource="{Binding MacroListViewModel.MacroItems}" ItemInvoked="NavigationView_ItemInvoked">
            <ContentControl Content="{Binding CurrentViewModel}" />
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="-25, 40, 15, 0">
                    <DockPanel>
                        <Button Margin="0, 5, 5, 5" Padding="5" Command="{Binding MacroListViewModel.OpenSaveFolderCommand}">
                            <ui:SymbolIcon Symbol="MoveToFolder"/>
                        </Button>

                        <Button Padding="5" Command="{Binding MacroListViewModel.RefreshMacrosCommand}">
                            <ui:SymbolIcon Symbol="Refresh"/>
                        </Button>

                        <ui:AutoSuggestBox PlaceholderText="Поиск." Margin="5" HorizontalAlignment="Stretch" DataContextChanged="AutoSuggestBox_DataContextChanged"/>
                    </DockPanel>
                    
                    <Separator Margin="0, 10, 0, 5"/>
                </StackPanel>
            </ui:NavigationView.PaneHeader>


            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="12,0,12,12">
                    <TextBlock Margin="0,0,0,6">
                        <Run Text="Записей " />
                        <Run Text="{Binding MacroListViewModel.MacrosCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </ui:NavigationView.PaneFooter>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Создать запись" Icon="Video" Tag="Recording"/>
                <ui:NavigationViewItem Content="Помощь" Icon="Help" Tag="Help"/>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</Window>