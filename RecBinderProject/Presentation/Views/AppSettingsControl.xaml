<UserControl x:Class="RecBinderProject.Views.AppSettingsControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RecBinderProject.Views"
      xmlns:ui="http://schemas.modernwpf.com/2019" 
             
      xmlns:appsettings="clr-namespace:RecBinderProject.Presentation.ViewModels.AppSettings"       
      d:DataContext="{d:DesignInstance Type=appsettings:AppSettingsViewModel}"
             
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid Margin="60, 20, 30, 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*" MaxHeight="50"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding LocalizatonViewModel.AppSettings[FirstLabel], Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="18" FontFamily="Segoe UI"/>
            <TextBlock Text="{Binding GeneralAppSettingsSectionViewModel.StatusText}" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="14" FontFamily="Segoe UI"/>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Label Content="{Binding LocalizatonViewModel.AppSettings[LanguageLabel], Mode=OneWay}" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="12" FontFamily="Segoe UI"/>
                <ComboBox  Grid.Row="1"  ItemsSource="{Binding GeneralAppSettingsSectionViewModel.AvailableAppLanguages}" SelectedItem="{Binding GeneralAppSettingsSectionViewModel.AppLanguage, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Vertical">
                <Label Content="{Binding LocalizatonViewModel.AppSettings[ThemeLabel], Mode=OneWay}" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="12" FontFamily="Segoe UI"/>
                <ComboBox  Grid.Row="1"  ItemsSource="{Binding GeneralAppSettingsSectionViewModel.AvailableAppThemes}" SelectedItem="{Binding GeneralAppSettingsSectionViewModel.AppTheme, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Vertical">
                <Label Content="{Binding LocalizatonViewModel.AppSettings[SaveDirectoryLabel], Mode=OneWay}" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="12" FontFamily="Segoe UI"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding GeneralAppSettingsSectionViewModel.SaveDirectory}" Grid.Column="0"/>
                    <Button Command="{Binding GeneralAppSettingsSectionViewModel.BrowseSaveDirectoryCommand}" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Vertical">
                <Label Content="{Binding LocalizatonViewModel.AppSettings[ScreenResolutionLabel], Mode=OneWay}" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="12" FontFamily="Segoe UI"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding GeneralAppSettingsSectionViewModel.MonitorWidth}" Grid.Column="0"/>
                    <TextBox Text="{Binding GeneralAppSettingsSectionViewModel.MonitorHeight}" Grid.Column="1"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="7" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,0,0">
                <Button Command="{Binding SaveCommand}" Content="{Binding LocalizatonViewModel.AppSettings[SaveButton], Mode=OneWay}" Margin="0,0,10,0" VerticalAlignment="Stretch"/>
                <Button Command="{Binding CancelCommand}" Content="{Binding LocalizatonViewModel.AppSettings[CancelButton], Mode=OneWay}"  Margin="0,0,20,0" VerticalAlignment="Stretch"/>
                <Button Command="{Binding ResetCommand}" Content="{Binding LocalizatonViewModel.AppSettings[ResetToDefaultButton], Mode=OneWay}"  Margin="0,0,0,0" VerticalAlignment="Stretch"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>