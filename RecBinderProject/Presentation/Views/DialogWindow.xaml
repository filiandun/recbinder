<Window x:Class="RecBinderProject.Presentation.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecBinderProject.Presentation.Views"
        
        xmlns:vm="clr-namespace:RecBinderProject.Presentation.ViewModels.DialogWindow"
        d:DataContext="{d:DesignInstance Type=vm:DialogWindowViewModel}"
        
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        
        mc:Ignorable="d"
        Title="DialogWindow">
    
    <Grid>
        <Border Width="auto" Height="auto" MinWidth="300" MinHeight="180" MaxWidth="500" MaxHeight="250" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorOnAccentSecondaryBrush}" CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="20">
                    <TextBlock Text="{Binding Title}" DockPanel.Dock="Top" Margin="0, 0, 0, 10" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ScrollViewer>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"/>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Row="1" Padding="20, 15" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseCommand}" Content="OK" Margin="0, 0, 10, 0" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
