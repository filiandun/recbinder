<UserControl x:Class="RecBinderProject.Presentation.Views.MacroLibrary.MacroLibraryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecBinderProject.Presentation.Views.MacroLibrary" 
             
             xmlns:vm="clr-namespace:RecBinderProject.Presentation.ViewModels.MacroLibrary" 
             d:DataContext="{d:DesignInstance Type=vm:MacroLibraryListViewModel}"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:MacroLibraryListItemViewModel}">
            <local:MacroLibraryListItemView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10, 5">
            <Grid.ColumnDefinitions>
                <!--<ColumnDefinition Width="*"/>-->
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <!-- TODO в дальнешем просится поиск очень -->
            <!--<TextBox Grid.Column="0" Text="Search" Margin="0, 0, 10, 0" IsEnabled="False"/>-->

            <Button Grid.Column="0" Command="{Binding OpenSaveFolderCommand}" Content="&#xE8DA;" Margin="0, 0, 10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
            <Button Grid.Column="1" Command="{Binding RefreshMacrosCommand}" Content="&#xE72C;" Margin="0, 0, 10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{Binding MacroItems}" SelectedItem="{Binding SelectedMacro}" Padding="5" SelectionMode="Single" HorizontalContentAlignment="Stretch" Background="Transparent"/>
    </Grid>
</UserControl>
