<UserControl x:Class="RecBinderProject.Presentation.Views.MacroLibraryView"  
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"   
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
      xmlns:local="clr-namespace:RecBinderProject.Presentation.Views"  
             
      xmlns:vm="clr-namespace:RecBinderProject.Presentation.ViewModels.MacroExecution" 
      d:DataContext="{d:DesignInstance Type=vm:MacroLibraryViewModel}"
      
      mc:Ignorable="d"   
      d:DesignHeight="450" d:DesignWidth="800">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- HEADER LABEL -->
        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding LocalizationViewModel.MacroExecution[Play_FirstLabel]}" Margin="10, 20" Style="{DynamicResource TitleTextBlockStyle}"/>
        
        <!-- MACROS LIST -->
        <ListView Grid.Column="0" Grid.Row="1" ItemsSource="{Binding MacroListViewModel.MacroItems}" SelectedItem="{Binding MacroListViewModel.SelectedMacro}" Margin="5" Padding="5" SelectionMode="Single" HorizontalContentAlignment="Stretch" Background="Transparent"/>

        <!-- INSPECTOR BAR -->
        <ScrollViewer Grid.Column="1" Grid.Row="1" Margin="5" Padding="5" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MacroPlaybackViewModel}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <!-- METADATA -->
                <StackPanel Grid.Row="1" Margin="0, 0, 0, 10">
                    <TextBlock Text="{Binding LocalizationViewModel.MacroExecution[MacroNameLabel]}" Margin="0, 0, 0, 5" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBox Text="{Binding MacroPlaybackViewModel.MacroMetadataViewerViewModel.MacroName}" IsEnabled="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="0, 0, 0, 20">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LocalizationViewModel.MacroExecution[MacroDescriptionLabel]}" Margin="0, 0, 0, 5" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBox Text="{Binding MacroPlaybackViewModel.MacroMetadataViewerViewModel.MacroDescription}" IsEnabled="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextWrapping="Wrap" />
                </DockPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0, 0, 0, 10">
                    <TextBlock Text="&#xE916;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MacroPlaybackViewModel.MacroMetadataViewerViewModel.MacroDuration}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0, 0, 0, 20">
                    <TextBlock Text="&#xEE93;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MacroPlaybackViewModel.MacroMetadataViewerViewModel.MacroCreationDateTime}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- OPTIONS -->
                <StackPanel Grid.Row="5" Margin="0, 0, 0, 0">
                    <TextBlock Text="{Binding LocalizationViewModel.MacroExecution[MacroOptionsLabel]}" Margin="0, 0, 0, 5" Style="{StaticResource CaptionTextBlockStyle}"/>

                    <UniformGrid VerticalAlignment="Bottom" Columns="1">
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.MacroOptions.KeyboardPressIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[KeyboardPressIgnoredButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.MacroOptions.MousePressIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MousePressIgnoredButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.MacroOptions.MouseMoveIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MouseMoveIgnoredButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.MacroOptions.MouseWheelIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MouseWheelIgnoredButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.MacroOptions.RelativeMouseMovementEnabled, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[RelativeMouseMovementEnabledButton]}" FontSize="12"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- TRANSPORT BAR -->
        <Grid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="10, 5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MacroPlaybackViewModel}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" Value="{Binding MacroPlaybackViewModel.MacroExecutionStatusViewModel.ProgressBarValue, Mode=OneWay}" Background="Transparent" Foreground="{Binding MacroPlaybackViewModel.MacroExecutionStatusViewModel.ProgressBarColor}" Height="auto" Maximum="100" Margin="0, 0, 10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Column="0" Command="{Binding MacroPlaybackViewModel.StartCommand}" Margin="0,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="{Binding MacroPlaybackViewModel.MacroExecutionStatusViewModel.StatusText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Command="{Binding MacroPlaybackViewModel.StopCommand}" Content="&#xE71A;" Margin="0, 0, 10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
            <Button Grid.Column="2" Command="{Binding MacroPlaybackViewModel.PauseCommand}" Content="&#xE769;" Margin="0, 0, 0, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
        </Grid>
    </Grid>
</UserControl>