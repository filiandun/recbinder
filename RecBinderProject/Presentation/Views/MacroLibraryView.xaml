<UserControl x:Class="RecBinderProject.Presentation.Views.MacroLibraryView"  
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"   
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
      xmlns:local="clr-namespace:RecBinderProject.Presentation.Views"  
             
      xmlns:vm="clr-namespace:RecBinderProject.Presentation.ViewModels.MacroLibrary" 
      d:DataContext="{d:DesignInstance Type=vm:MacroLibraryViewModel}"
      
      mc:Ignorable="d"   
      d:DesignHeight="450" d:DesignWidth="800">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- HEADER LABEL -->
        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding LocalizationViewModel.MacroExecution[Play_FirstLabel]}" Margin="10, 20" Style="{DynamicResource TitleTextBlockStyle}"/>
        
        <!-- MACROS LIST -->
        <Grid Margin="5" Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10, 5">
                <Grid.ColumnDefinitions>
                    <!--<ColumnDefinition Width="*"/>-->
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- TODO в дальнешем просится поиск очень -->
                <!--<TextBox Grid.Column="0" Text="Search" Margin="0, 0, 10, 0" IsEnabled="False"/>-->
                
                <Button Grid.Column="0" Command="{Binding MacroListViewModel.OpenSaveFolderCommand}" Content="&#xE8DA;" Margin="0, 0, 10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                <Button Grid.Column="1" Command="{Binding MacroListViewModel.RefreshMacrosCommand}" Content="&#xE72C;" Margin="0, 0, 10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
            </Grid>
            
            <ListView Grid.Row="1" ItemsSource="{Binding MacroListViewModel.MacroItems}" SelectedItem="{Binding MacroListViewModel.SelectedMacro}" Padding="5" SelectionMode="Single" HorizontalContentAlignment="Stretch" Background="Transparent"/>
        </Grid>

        <!-- INSPECTOR BAR -->
        <ScrollViewer Grid.Column="1" Grid.Row="1" Margin="5" Padding="5" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MacroPlaybackViewModel}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <!-- METADATA -->
                <StackPanel Grid.Row="1" Margin="0, 0, 0, 10">
                    <TextBlock Text="{Binding LocalizationViewModel.MacroExecution[MacroNameLabel]}" Margin="0, 0, 0, 5" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBox Text="{Binding MacroPlaybackViewModel.MetadataViewerViewModel.MacroName}" IsEnabled="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="0, 0, 0, 20">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LocalizationViewModel.MacroExecution[MacroDescriptionLabel]}" Margin="0, 0, 0, 5" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBox Text="{Binding MacroPlaybackViewModel.MetadataViewerViewModel.MacroDescription}" IsEnabled="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextWrapping="Wrap" />
                </DockPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0, 0, 0, 10">
                    <TextBlock Text="&#xE916;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MacroPlaybackViewModel.MetadataViewerViewModel.MacroDuration}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0, 0, 0, 20">
                    <TextBlock Text="&#xEE93;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MacroPlaybackViewModel.MetadataViewerViewModel.MacroCreationDateTime}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- OPTIONS -->
                <StackPanel Grid.Row="5" Margin="0, 0, 0, 0">
                    <TextBlock Text="{Binding LocalizationViewModel.MacroExecution[MacroOptionsLabel]}" Margin="0, 0, 0, 5" Style="{StaticResource CaptionTextBlockStyle}"/>

                    <UniformGrid VerticalAlignment="Bottom" Columns="1">
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.OptionsViewModel.KeyboardPressIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[KeyboardPressIgnoredButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.OptionsViewModel.MousePressIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MousePressIgnoredButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.OptionsViewModel.MouseMoveIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MouseMoveIgnoredButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.OptionsViewModel.MouseWheelIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MouseWheelIgnoredButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.OptionsViewModel.RelativeMouseMovementEnabled, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[RelativeMouseMovementEnabledButton]}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding MacroPlaybackViewModel.OptionsViewModel.TrimPlaybackEndEnabled, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[TrimPlaybackEndEnabled]}" FontSize="12"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- TRANSPORT BAR -->
        <Grid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="10, 5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MacroPlaybackViewModel}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- START BUTTON AND PROGRESS BAR -->
            <ProgressBar Grid.Column="0" Value="{Binding MacroPlaybackViewModel.StatusViewModel.ProgressBarValue, Mode=OneWay}" Background="Transparent" Foreground="{Binding MacroPlaybackViewModel.StatusViewModel.ProgressBarColor}" Height="auto" Maximum="100" Margin="0, 0, 10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Column="0" Command="{Binding MacroPlaybackViewModel.StartCommand}" Margin="0,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="{Binding MacroPlaybackViewModel.StatusViewModel.StatusText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            
            <StackPanel Grid.Column="0" Margin="0, 0, 10, 0" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- SPEED CONTROL -->
                <StackPanel>
                    <ToggleButton x:Name="SpeedButton" Content="&#xEC48;" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}" />

                    <Popup Margin="10" IsOpen="{Binding IsChecked, Mode=OneWay, ElementName=SpeedButton}" PlacementTarget="{Binding ElementName=SpeedButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                        <Border Width="200" Padding="10" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                            <StackPanel>
                                <TextBlock Text="Speed option" Padding="0, 0, 0, 5" FontSize="12"/>
                                <Slider Margin="5" Minimum="0.5" Maximum="2" Value="{Binding MacroPlaybackViewModel.OptionsViewModel.Speed, Mode=TwoWay}" IsSnapToTickEnabled="True" Ticks="0.5, 0.75, 1.00, 1.25, 1.50, 1.75, 2.00" TickPlacement="BottomRight"/>
                                <TextBlock Text="{Binding MacroPlaybackViewModel.OptionsViewModel.Speed}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- LOOP CONTROL -->
                <StackPanel>
                    <ToggleButton x:Name="LoopButton" Content="&#xE8EE;" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}"/>

                    <Popup Margin="10" IsOpen="{Binding IsChecked, ElementName=LoopButton}" PlacementTarget="{Binding ElementName=LoopButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                        <Border Width="200" Padding="10" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">

                            <StackPanel>
                                <TextBlock Text="Loop option" Padding="0, 0, 0, 5" FontSize="12"/>
                                
                                <CheckBox Content="Loop enabled" IsChecked="{Binding MacroPlaybackViewModel.OptionsViewModel.LoopEnabled, Mode=TwoWay}"/>

                                <StackPanel IsEnabled="{Binding MacroPlaybackViewModel.OptionsViewModel.LoopEnabled}">
                                    <Border Grid.Row="0" Margin="0, 0, 0, 10" Padding="10, 5" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8ED;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Count" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBox Grid.Column="1" Text="{Binding MacroPlaybackViewModel.OptionsViewModel.LoopCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="0" Margin="0, 0, 0, 10" Padding="10, 5" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE823;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Delay (ms)" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBox Grid.Column="1" Text="{Binding MacroPlaybackViewModel.OptionsViewModel.LoopDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding MacroPlaybackViewModel.StopCommand}" Content="&#xE71A;" Margin="0, 0, 10, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
            <Button Grid.Column="2" Command="{Binding MacroPlaybackViewModel.PauseCommand}" Content="&#xE769;" Margin="0, 0, 0, 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
        </Grid>
    </Grid>
</UserControl>