<UserControl x:Class="RecBinderProject.Presentation.Views.MacroListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecBinderProject"
             xmlns:ui="http://schemas.modernwpf.com/2019" 
             
             xmlns:vm="clr-namespace:RecBinderProject.Presentation.ViewModels.MainWindow"
           
             d:DataContext="{d:DesignInstance Type=vm:MacroListItemViewModel}"

             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="350" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">


    <Grid Width="auto" Margin="0">
        <Border Padding="20, 5, 20, 5" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="5">
            <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding MacroName}" IsEnabled="False" FontWeight="Bold"/>
                        <Separator />
                        <MenuItem Header="Воспроизвести"/>
                        <MenuItem Header="Пауза"/>
                        <MenuItem Header="Остановить"/>
                        <Separator />
                        <MenuItem Header="Показать в проводнике"/>
                        <Separator />
                        <MenuItem Header="Редактировать"/>
                        <MenuItem Header="Удалить"/>
                    </ContextMenu>
                </Border.ContextMenu>

            <UniformGrid Rows="2">
                <Label HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{Binding MacroName}"/>
                <!--<Label HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{Binding MacroDescription}" FontSize="9"/>-->
                <Label HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{Binding MacroDuration}" FontSize="9"/>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
