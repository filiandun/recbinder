<UserControl x:Class="RecBinderProject.Views.MacroListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecBinderProject"
             xmlns:ui="http://schemas.modernwpf.com/2019" 
             
             xmlns:vm="clr-namespace:RecBinderProject.Presentation.ViewModels.MainWindow"
             d:DataContext="{d:DesignInstance Type=vm:MacroListItemViewModel}"

             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="350" MaxHeight="50" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding MacroName}" IsEnabled="False" FontWeight="Bold"/>
                <Separator />
                <MenuItem Header="Воспроизвести"/>
                <MenuItem Header="Пауза"/>
                <MenuItem Header="Остановить"/>
                <Separator />
                <MenuItem Header="Показать в проводнике"/>
                <Separator />
                <MenuItem Header="Редактировать"/>
                <MenuItem Header="Удалить"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <UniformGrid Rows="2">
            <Label x:Name="recordNameLabel" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{Binding MacroName}"/>
            <Label x:Name="recordDescriptionLabel" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{Binding MacroDescription}" FontSize="9"/>
        </UniformGrid>

        <Button Content="▶" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="{x:Null}" Background="{x:Null}"/>

        <Button Content="■" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}"/>
    </Grid>
</UserControl>
