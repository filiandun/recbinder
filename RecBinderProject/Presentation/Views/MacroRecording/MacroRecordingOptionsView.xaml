<UserControl x:Class="RecBinderProject.Presentation.Views.MacroRecording.MacroRecordingOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecBinderProject.Presentation.Views.MacroRecording"
             
             xmlns:vm="clr-namespace:RecBinderProject.Presentation.ViewModels.MacroExecution" 
             d:DataContext="{d:DesignInstance Type=vm:MacroRecordingViewModel}"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding LocalizationViewModel.MacroExecution[MacroOptionsLabel]}" Margin="0, 0, 0, 5" Style="{StaticResource CaptionTextBlockStyle}"/>

                <UniformGrid VerticalAlignment="Bottom" Columns="1">
                    <CheckBox IsChecked="{Binding OptionsViewModel.KeyboardPressIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[KeyboardPressIgnoredButton]}" FontSize="12"/>
                    <CheckBox IsChecked="{Binding OptionsViewModel.MousePressIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MousePressIgnoredButton]}" FontSize="12"/>
                    <CheckBox IsChecked="{Binding OptionsViewModel.MouseMoveIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MouseMoveIgnoredButton]}" FontSize="12"/>
                    <CheckBox IsChecked="{Binding OptionsViewModel.MouseWheelIgnored, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[MouseWheelIgnoredButton]}" FontSize="12"/>
                    
                    <CheckBox IsChecked="{Binding OptionsViewModel.TreeDimensionalMouseMovementEnabled, Mode=TwoWay}" Content="{Binding LocalizationViewModel.MacroExecution[TreeDimensionalMouseMovementEnabled]}" FontSize="12"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
