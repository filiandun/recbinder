<Window x:Class="RecBinderProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:RecBinderProject"
        
        xmlns:views="clr-namespace:RecBinderProject.Presentation.Views"
        xmlns:macrolibview="clr-namespace:RecBinderProject.Presentation.Views.MacroLibrary"
        xmlns:macrorecview="clr-namespace:RecBinderProject.Presentation.Views.MacroRecording"
      
        xmlns:appvm="clr-namespace:RecBinderProject.Presentation.ViewModels.AppSettings"
        xmlns:exevm="clr-namespace:RecBinderProject.Presentation.ViewModels.MacroExecution"
        xmlns:libvm="clr-namespace:RecBinderProject.Presentation.ViewModels.MacroLibrary"
       
        xmlns:mainwm="clr-namespace:RecBinderProject.Presentation.ViewModels.MainWindow" 
        
        d:DataContext="{d:DesignInstance Type=mainwm:MainWindowViewModel}"
        
        mc:Ignorable="d"
        Title="RecBinder" Height="600" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type exevm:MacroRecordingViewModel}">
            <macrorecview:MacroRecordingView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type libvm:MacroLibraryViewModel}">
            <macrolibview:MacroLibraryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type appvm:AppSettingsViewModel}">
            <views:AppSettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type libvm:MacroListItemViewModel}">
            <views:MacroListItemControl />
        </DataTemplate>
    </Window.Resources>

    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200px"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>

        <!-- NAVIGATION BAR -->
        <Grid Grid.Column="0" Margin="5, 20, 0, 5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <!-- HEADER -->
            <ListView Grid.Row="0" SelectedIndex="{Binding SelectedMenuIndex}">
                <ListViewItem Tag="MacrosList">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA37;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LocalizationViewModel.MacroList[FirstLabel]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>

                <ListViewItem Tag="Recording">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LocalizationViewModel.MacroList[RecordingButton]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>
            
            <!-- FOOTER -->
            <StackPanel Grid.Row="1">
                <Button Command="{Binding OpenHelpCommand}" Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Margin="0, 0, 10 ,0" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LocalizationViewModel.MacroList[HelpButton]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Margin="0, 0, 10, 0" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LocalizationViewModel.MacroList[SettingsButton]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" Margin="5, 15, 0, 0" Padding="10" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="Transparent" CornerRadius="8, 0, 0, 0">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>