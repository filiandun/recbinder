<Page x:Class="RecBinderProject.RecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RecBinderProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RecordedPage">

    <Grid>
        <UniformGrid Rows="4" HorizontalAlignment="Center">
            <TextBlock x:Name="recordNameTextBlock" Text="Это имя записи"/>
            <TextBlock x:Name="recordDurationTextBlock" Text="Это длительность записи"/>
            <TextBlock x:Name="recordDateTimeTextBlock" Text="Это дата записи"/>
            <TextBlock x:Name="recordDescriptionTextBlock" Text="Это описание записи"/>
        </UniformGrid>
    </Grid>
</Page>
