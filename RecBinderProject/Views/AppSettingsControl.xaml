<UserControl x:Class="RecBinderProject.Views.AppSettingsControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RecBinderProject.Views"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid Margin="60, 20, 30, 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Настройки" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" FontSize="18" FontFamily="Segoe UI"/>
            <TextBlock Text="{Binding GeneralAppSettingsSectionViewModel.StatusText}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="White" FontSize="14" FontFamily="Segoe UI"/>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Label Content="Тема" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <ComboBox ItemsSource="{Binding GeneralAppSettingsSectionViewModel.AvailableApplicationThemes}" Grid.Row="1">
                    <!--<ComboBoxItem Content="Как в системе"/>-->
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Vertical">
                <Label Content="Путь к папке с сохранёнными записями" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding GeneralAppSettingsSectionViewModel.SaveDirectory}" Grid.Column="0"/>
                    <Button Command="{Binding GeneralAppSettingsSectionViewModel.BrowseSaveDirectoryCommand}" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Vertical">
                <Label Content="Разрешение монитора (ширина и высота)" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding GeneralAppSettingsSectionViewModel.MonitorWidth}" Grid.Column="0"/>
                    <TextBox Text="{Binding GeneralAppSettingsSectionViewModel.MonitorHeight}" Grid.Column="1"/>
                </Grid>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="7" Margin="0,0,0,0">
                <Button Command="{Binding SaveCommand}" Content="Сохранить" Margin="0,10,10,10" VerticalAlignment="Stretch"/>
                <Button Command="{Binding CancelCommand}" Content="Отменить"  Margin="0,10,20,10" VerticalAlignment="Stretch"/>
                <Button Command="{Binding ResetCommand}" Content="Сбросить по умолчанию"  Margin="0,10,0,10" VerticalAlignment="Stretch"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>