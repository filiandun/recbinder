<Page x:Class="RecBinderProject.CreateRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RecBinderProject"
      xmlns:ui="http://schemas.modernwpf.com/2019" xmlns:viewmodels="clr-namespace:RecBinderProject.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RecordingPage">

    <Grid>
        <Grid Margin="60, 20, 30, 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Начать новую запись" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" FontSize="18" FontFamily="Segoe UI"/>

            <StackPanel Grid.Row="1">
                <Label Content="Название" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <TextBox x:Name="TextBox" Text="{Binding RecordingMetadataViewModel.RecordName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" ToolTip="{Binding (Validation.Errors)[0].ErrorContent, ElementName=TextBox}" IsEnabled="{Binding IsPropertyEnabled}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <DockPanel Grid.Row="2">
                <Label Content="Описание" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <TextBox Text="{Binding RecordingMetadataViewModel.RecordDescription, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" IsEnabled="{Binding IsPropertyEnabled}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            </DockPanel>

            <Grid x:Name="durationGrid" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Продолительность записи" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>

                <ui:NumberBox Value="{Binding RecordingMetadataViewModel.RecordDurationValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" IsEnabled="{Binding IsPropertyEnabled}" Grid.Column="0" Grid.Row="1" SpinButtonPlacementMode="Inline"/>
                <ComboBox SelectedIndex="{Binding RecordingMetadataViewModel.RecordDurationUnitIndex}" IsEnabled="{Binding IsPropertyEnabled}" Grid.Column="1" Grid.Row="1" >
                    <ComboBoxItem Content="мс."/>
                    <ComboBoxItem Content="сек."/>
                    <ComboBoxItem Content="мин." IsSelected="True"/>
                </ComboBox>
            </Grid>

            <Grid x:Name="settingsGrid" Grid.Row="4">
                <Label Content="Настройки" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <UniformGrid VerticalAlignment="Bottom">
                    <CheckBox IsChecked="{Binding RecordOptions.IgnoreKeyboardPress, Mode=TwoWay}" Content="Игнорировать нажатия клавиш клавиатуры"/>
                    <CheckBox IsChecked="{Binding RecordOptions.IgnoreMousePress, Mode=TwoWay}" Content="Игнорировать нажатия клавиш мыши"/>
                    <CheckBox IsChecked="{Binding RecordOptions.IgnoreMouseMove, Mode=TwoWay}" Content="Игнорировать движения мыши"/>
                    <CheckBox IsChecked="{Binding RecordOptions.IgnoreMouseWheel, Mode=TwoWay}" Content="Игнорировать прокручивания колёсика мыши"/>
                </UniformGrid>
            </Grid>

            <UniformGrid Grid.Row="6" Rows="1">
                <Button Command="{Binding StartRecordCommand}" Content="{Binding StatusText}" Margin="0,10,40,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Command="{Binding StopRecordCommand}" Content="Остановить запись" Margin="0,10,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Page>
