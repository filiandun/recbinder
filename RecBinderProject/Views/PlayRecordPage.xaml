<Page x:Class="RecBinderProject.ShowRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RecBinderProject"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RecordedPage">

    <Grid>
        <Grid Margin="60, 20, 30, 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Просмотр, редактирование и воспроизведение записи" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" FontSize="18" FontFamily="Segoe UI"/>

            <StackPanel Grid.Row="1">
                <Label Content="Название" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <TextBox x:Name="recordNameTextBox" Text="{Binding RecordingMetadataViewModel.RecordName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, Mode=TwoWay}" ToolTip="{Binding (Validation.Errors)[0].ErrorContent, ElementName=recordNameTextBox}" IsEnabled="{Binding IsPropertyEnabled}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <DockPanel Grid.Row="2">
                <Label Content="Описание" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <TextBox x:Name="recordDescriptionTextBox" Text="{Binding RecordingMetadataViewModel.RecordDescription, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, Mode=TwoWay}" ToolTip="{Binding (Validation.Errors)[0].ErrorContent, ElementName=recordDescriptionTextBox}" IsEnabled="{Binding IsPropertyEnabled}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
            </DockPanel>

            <StackPanel Grid.Row="3">
                <Label Content="Продолжительность" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <Label x:Name="recordDurationLabel" Content="{Binding RecordingMetadataViewModel.RecordDuration, Mode=TwoWay}" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <Label Content="Дата и время" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <Label x:Name="recordDateTimeLabel" Content="{Binding RecordingMetadataViewModel.RecordCreationDateTime, Mode=TwoWay}" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>

            <Grid x:Name="settingsGrid" Grid.Row="5">
                <Label Content="Настройки" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <UniformGrid VerticalAlignment="Bottom">
                    <CheckBox IsChecked="{Binding RecordOptions.IgnoreKeyboardPress, Mode=TwoWay}" Content="Игнорировать нажатия клавиш клавиатуры"/>
                    <CheckBox IsChecked="{Binding RecordOptions.IgnoreMousePress, Mode=TwoWay}" Content="Игнорировать нажатия клавиш мыши"/>
                    <CheckBox IsChecked="{Binding RecordOptions.IgnoreMouseMove, Mode=TwoWay}" Content="Игнорировать движения мыши"/>
                    <CheckBox IsChecked="{Binding RecordOptions.IgnoreMouseWheel, Mode=TwoWay}" Content="Игнорировать прокручивания колёсика мыши"/>
                </UniformGrid>
            </Grid>

            <UniformGrid Grid.Row="6" Rows="1">
                <Button Command="{Binding StartPlayingCommand}" Content="{Binding StatusText}" Margin="0,10,40,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Button Command="{Binding StopPlayingCommand}" Content="Остановить воспроизведение записи"  Margin="0,10,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Page>
