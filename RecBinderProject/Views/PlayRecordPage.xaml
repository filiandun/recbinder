<Page x:Class="RecBinderProject.ShowRecordPage"  
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"   
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
      xmlns:local="clr-namespace:RecBinderProject"  
      xmlns:ui="http://schemas.modernwpf.com/2019"  
      mc:Ignorable="d"   
      d:DesignHeight="450" d:DesignWidth="800"  
      Title="RecordedPage">  

    <Grid>  
        <Grid Margin="60, 20, 30, 30">  
            <Grid.RowDefinitions>  
                <RowDefinition Height="*"/>  
                <RowDefinition Height="*"/>  
                <RowDefinition Height="2*"/>  
                <RowDefinition Height="*"/>  
                <RowDefinition Height="*"/>  
                <RowDefinition Height="2*"/>  
                <RowDefinition Height="*" MaxHeight="50"/>  
            </Grid.RowDefinitions>  

            <TextBlock Text="Просмотр, редактирование и воспроизведение записи" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" FontSize="18" FontFamily="Segoe UI"/>  

            <StackPanel Grid.Row="1">  
                <Label Content="Название" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <TextBox x:Name="recordNameTextBox" Text="{Binding RecordingMetadataViewModel.RecordName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, Mode=TwoWay}" ToolTip="{Binding (Validation.Errors).CurrentItem.ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="{Binding IsPropertyEnabled}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>  
            </StackPanel>  

            <DockPanel Grid.Row="2">  
                <Label Content="Описание" Margin="0, 0, 0, 5" DockPanel.Dock="Top" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>
                <TextBox x:Name="recordDescriptionTextBox" Text="{Binding RecordingMetadataViewModel.RecordDescription, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, Mode=TwoWay}" ToolTip="{Binding (Validation.Errors).CurrentItem.ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="{Binding IsPropertyEnabled}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>  
            </DockPanel>  

            <StackPanel Grid.Row="3">  
                <Label Content="Продолжительность" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>  
                <Label x:Name="recordDurationLabel" Content="{Binding RecordingMetadataViewModel.RecordDurationStr}" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>  
            </StackPanel>  

            <StackPanel Grid.Row="4">  
                <Label Content="Дата и время" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>  
                <Label x:Name="recordDateTimeLabel" Content="{Binding RecordingMetadataViewModel.RecordCreationDateTimeStr}" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>  
            </StackPanel>  

            <Grid x:Name="settingsGrid" Grid.Row="5">  
                <Label Content="Настройки" Margin="0, 0, 0, 5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Foreground="White" FontSize="12" FontFamily="Segoe UI"/>  
                <UniformGrid VerticalAlignment="Bottom" Columns="2">
                    <CheckBox IsChecked="{Binding RecordOptions.KeyboardPressEnabled, Mode=TwoWay}" Content="Игнорировать нажатия клавиш клавиатуры"/>
                    <CheckBox IsChecked="{Binding RecordOptions.MousePressEnabled, Mode=TwoWay}" Content="Игнорировать нажатия клавиш мыши"/>
                    <CheckBox IsChecked="{Binding RecordOptions.MouseMoveEnabled, Mode=TwoWay}" Content="Игнорировать движения мыши"/>
                    <CheckBox IsChecked="{Binding RecordOptions.MouseWheelEnabled, Mode=TwoWay}" Content="Игнорировать прокручивания колёсика мыши"/>
                    <CheckBox IsChecked="{Binding RecordOptions.RelativeMouseMovementEnabled, Mode=TwoWay}" Content="Воспроизвести относительно текущего положения курсора"/>  
                </UniformGrid>  
            </Grid>

            <Grid x:Name="controlGrid" Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" Value="{Binding RecordingStateViewModel.ProgressBarValue, Mode=OneWay}" Maximum="100" Margin="0,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="#FF4BB51C"/>
                <Button Grid.Column="0" Command="{Binding StartCommand}" Content="{Binding RecordingStateViewModel.ButtonText, Mode=OneWay}" Margin="0,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <Button Grid.Column="1" Command="{Binding StopCommand}" Content="[]" Margin="0,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#33FF0000"/>
                <Button Grid.Column="2" Command="{Binding StopCommand}" Content="II" Margin="0,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>  
    </Grid>  
</Page>
